{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "MusicIsland",
  "version": "0.1.0",
  "identifier": "com.musicisland.app",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "MusicIsland",
        "label": "main",
        "width": 460,
        "height": 48,
        "decorations": false,
        "transparent": true,
        "alwaysOnTop": false,
        "shadow": false,
        "resizable": true,
        "skipTaskbar": true,
        "center": false,
        "x": 0,
        "y": 8
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "publisher": "Derrylen Fernanda",
    "copyright": "Copyright © 2026 Derrylen Fernanda",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico"
    ]
  }
}
